# Cirrus release to deploy. Never use "latest" in production.
CIRRUS_VERSION=0.2.0
CIRRUS_IMAGE_PREFIX=ghcr.io/siliciummangel/mtsm-cirrus

# The API remains private to the host. A reverse proxy terminates TLS.
CIRRUS_BIND_ADDRESS=127.0.0.1
CIRRUS_API_PORT=8080
CIRRUS_ALLOWED_HOSTS=cirrus.example.com

# Credentials for the bundled PostgreSQL instance.
CIRRUS_POSTGRES_DATABASE=cirrus
CIRRUS_POSTGRES_USER=cirrus
CIRRUS_POSTGRES_PASSWORD=replace-with-a-long-random-password

# Credentials for the bundled S3-compatible SeaweedFS instance.
CIRRUS_S3_ACCESS_KEY=replace-with-a-random-access-key
CIRRUS_S3_SECRET_KEY=replace-with-a-long-random-secret-key
CIRRUS_S3_REGION=us-east-1

# API limits. Align the reverse proxy's body-size limit with the upload limit.
CIRRUS_API_MAX_MULTIPART_UPLOAD_SIZE_BYTES=1073741824
CIRRUS_API_MAX_UPLOAD_METADATA_SIZE_BYTES=65536
CIRRUS_API_RATE_LIMIT_PERMIT_COUNT=300
CIRRUS_API_RATE_LIMIT_WINDOW_SECONDS=60

# Scheduled archive integrity verification.
CIRRUS_INTEGRITY_CHECKS_ENABLED=true
CIRRUS_INTEGRITY_INITIAL_VERIFICATION_DELAY_HOURS=24
CIRRUS_INTEGRITY_REVERIFICATION_INTERVAL_DAYS=180
CIRRUS_INTEGRITY_FAILURE_RETRY_DELAY_MINUTES=60
CIRRUS_INTEGRITY_POLLING_INTERVAL_SECONDS=60
CIRRUS_INTEGRITY_BATCH_SIZE=10
CIRRUS_INTEGRITY_MAX_CONCURRENT_CHECKS=2
CIRRUS_INTEGRITY_LEASE_DURATION_MINUTES=30

# Retention-aware physical deletion.
CIRRUS_PURGE_ENABLED=true
CIRRUS_PURGE_POLLING_INTERVAL_SECONDS=60
CIRRUS_PURGE_BATCH_SIZE=10
CIRRUS_PURGE_MAX_CONCURRENT_DELETES=2
CIRRUS_PURGE_LEASE_DURATION_MINUTES=30
CIRRUS_PURGE_INITIAL_RETRY_DELAY_MINUTES=5
CIRRUS_PURGE_MAXIMUM_RETRY_DELAY_MINUTES=1440

# Structured console logging levels.
CIRRUS_LOG_LEVEL_DEFAULT=Information
CIRRUS_LOG_LEVEL_ASPNETCORE=Warning
CIRRUS_LOG_LEVEL_EF_COMMANDS=Warning
