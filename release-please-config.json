{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "b57946d39ae4e34ffbcfe2f440246824affd03a4",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "MTSM.Cirrus",
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true,
      "version-file": "version.txt",
      "extra-files": [
        {
          "type": "generic",
          "path": "deploy/helm/cirrus/Chart.yaml"
        },
        {
          "type": "generic",
          "path": "deploy/helm/cirrus/values.yaml"
        }
      ],
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "include-v-in-release-name": true,
      "draft": true,
      "force-tag-creation": true,
      "pull-request-title-pattern": "chore(release): prepare ${version}",
      "changelog-sections": [
        { "type": "security", "section": "Security", "hidden": false },
        { "type": "feat", "section": "Features", "hidden": false },
        { "type": "fix", "section": "Fixes", "hidden": false },
        { "type": "perf", "section": "Performance", "hidden": false },
        { "type": "ops", "section": "Deployment and operations", "hidden": false },
        { "type": "docs", "section": "Documentation", "hidden": false },
        { "type": "deps", "section": "Dependencies", "hidden": false },
        { "type": "revert", "section": "Reverts", "hidden": false },
        { "type": "chore", "section": "Internal", "hidden": true },
        { "type": "test", "section": "Internal", "hidden": true },
        { "type": "ci", "section": "Internal", "hidden": true },
        { "type": "build", "section": "Internal", "hidden": true },
        { "type": "refactor", "section": "Internal", "hidden": true },
        { "type": "style", "section": "Internal", "hidden": true }
      ]
    }
  }
}
